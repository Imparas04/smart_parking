# Copy to .env (loaded automatically; real environment variables take precedence). Never commit .env.

# --- Core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated; spaces are ignored
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: sqlite (default) or mysql (requires: pip install mysqlclient) ---
DB_ENGINE=sqlite
# DB_NAME=smart_parking
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Production (only used when DJANGO_DEBUG=False) ---
# DJANGO_SECRET_KEY must then be a random 50+ character value, otherwise the app refuses to start
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_BEHIND_PROXY=True            # trust X-Forwarded-Proto from your reverse proxy
# DJANGO_TRUSTED_PROXY_COUNT=1        # number of proxies in front of the app (for client IP / throttling)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://parking.example.com

# --- Security tuning ---
# DJANGO_AUTH_THROTTLE=20/min          # rate limit for API login/register, per client IP
# DJANGO_CSP_REPORT_ONLY=False         # True = report Content-Security-Policy violations without blocking
